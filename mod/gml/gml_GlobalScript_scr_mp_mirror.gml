// DELTARUNE Multiplayer - cutscene mirror.
//
// A shared story cutscene plays only in the leader's game (whoever started it). Everyone else
// (sstate 5) sees what the leader's game shows:
//  - their own room is switched off (instances deactivated: nothing in it runs or draws), so the
//    room's own copy of the cutscene never starts; its background and tiles still show;
//  - the leader sends, every frame, the camera and the sprites on screen in drawing order
//    (types 70-75, unreliable, up to 46 sprites each); obj_mp_mirror draws them;
//  - text boxes are real ones: the leader sends the box's lines, face and voice when it opens one
//    (77 lines, 78 show) and the follower opens the same box itself (same font, face, typing
//    sound); the leader turns its pages for everyone (mp_dlg_input) once it has finished typing
//    on every screen;
//  - sounds the leader's scene plays are played too (76), and the leader's music;
//  - at the end (type 31) the follower is moved to where the leader ended up and its room is
//    built again, with the story changes the scene made.
// What each object draws comes from scr_mp_mirrorinfo, generated by the patcher (MirrorInfo.cs).

function mp_mirror_init()
{
    global.mp_mir_list = ds_list_create();      // my room's instances, switched off while mirroring
    global.mp_mir_hdr = -1;                     // [frame, room, cam x, cam y, chunk count, time]
    global.mp_mir_chunks = array_create(6, -1); // per chunk: [frame, sprites]
    global.mp_mir_seq = 0;
    global.mp_mir_lines = array_create(64, "");
    global.mp_mir_grid = ds_grid_create(10, 64);
    global.mp_mir_choice = -1;
    global.mp_mir_choice_t = 0;
    global.mp_mir_frozen_room = -1;
    mp_mirror_info_init();
    // Text boxes are opened by the followers themselves; the mod's own objects are never sent.
    var never = ["obj_writer", "obj_dialoguer", "obj_face", "obj_smallface", "obj_choicer_neo", "obj_mp_controller", "obj_mp_ghost", "obj_mp_mirror"];
    for (var i = 0; i < array_length(never); i++)
    {
        var o = asset_get_index(never[i]);
        if (o >= 0 && o < array_length(global.mp_mi_kind))
            global.mp_mi_kind[o] = 2;
    }
}

function mp_mirror_reset()
{
    global.mp_mir_hdr = -1;
    for (var i = 0; i < 6; i++)
        global.mp_mir_chunks[i] = -1;
    global.mp_mir_choice = -1;
    ds_list_clear(global.mp_mir_list);
    global.mp_mir_frozen_room = -1;
}

// ---------------------------------------------------------------- leader

// obj_mp_controller End Step: the sprites on my screen, for the players mirroring my cutscene.
function mp_mirror_lead_tick()
{
    if (!mp_on() || global.mp_sstate != 1 || mp_player_count() < 2 || mp_in_battle_scene())
        return;
    var cam = view_camera[0];
    var vx = camera_get_view_x(cam);
    var vy = camera_get_view_y(cam);
    var vw = camera_get_view_width(cam);
    var vh = camera_get_view_height(cam);
    var g = global.mp_mir_grid;
    if (ds_grid_height(g) < 300)
        ds_grid_resize(g, 10, 300);
    var n = 0;
    var kinds = global.mp_mi_kind;
    var evals = global.mp_mi_eval;
    var nk = array_length(kinds);
    with (all)
    {
        if (visible && n < 300)
        {
            var oi = object_index;
            var k = 2;
            if (oi >= 0 && oi < nk)
                k = kinds[oi];
            var r = -1;
            if (k == 3)
                r = script_execute(evals[oi]);
            else if (k != 2 && sprite_index >= 0)
                r = [sprite_index, image_index, x, y, image_xscale, image_yscale, image_angle, image_blend, image_alpha];
            if (is_array(r) && sprite_exists(r[0]) && r[8] > 0)
            {
                var big = max(sprite_get_width(r[0]) * abs(r[4]), sprite_get_height(r[0]) * abs(r[5]));
                if ((r[2] + big) >= vx && (r[2] - big) <= (vx + vw) && (r[3] + big) >= vy && (r[3] - big) <= (vy + vh))
                {
                    var nf = sprite_get_number(r[0]);
                    ds_grid_set(g, 0, n, depth);
                    ds_grid_set(g, 1, n, r[0]);
                    ds_grid_set(g, 2, n, nf > 0 ? (floor(r[1]) mod nf) : 0);
                    ds_grid_set(g, 3, n, r[2]);
                    ds_grid_set(g, 4, n, r[3]);
                    ds_grid_set(g, 5, n, r[4]);
                    ds_grid_set(g, 6, n, r[5]);
                    ds_grid_set(g, 7, n, r[6]);
                    ds_grid_set(g, 8, n, r[7]);
                    ds_grid_set(g, 9, n, r[8]);
                    n += 1;
                }
            }
        }
    }
    // Drawing order: deepest first.
    if (n > 1)
    {
        ds_grid_resize(g, 10, n);
        ds_grid_sort(g, 0, false);
    }
    global.mp_mir_seq += 1;
    var per = 46;
    var chunks = clamp(ceil(n / per), 1, 6);
    for (var c = 0; c < chunks; c++)
    {
        // Past 138 sprites, the rest go every other frame (the link sends 4 datagrams a frame).
        if (c >= 3 && (global.mp_mir_seq mod 2) == 1)
            continue;
        mp_begin(70 + c);
        mp_wu32(global.mp_mir_seq);
        mp_wu16(room);
        mp_ws16(vx);
        mp_ws16(vy);
        mp_wu8(c);
        mp_wu8(chunks);
        var a = c * per;
        var b = min(n, a + per);
        mp_wu8(max(0, b - a));
        for (var i = a; i < b; i++)
        {
            mp_wu16(ds_grid_get(g, 1, i));
            mp_wu8(ds_grid_get(g, 2, i));
            mp_ws16(ds_grid_get(g, 3, i));
            mp_ws16(ds_grid_get(g, 4, i));
            buffer_write(global.mp_msg, buffer_f32, ds_grid_get(g, 5, i));
            buffer_write(global.mp_msg, buffer_f32, ds_grid_get(g, 6, i));
            mp_ws16(ds_grid_get(g, 7, i));
            var col = ds_grid_get(g, 8, i);
            mp_wu8(colour_get_red(col));
            mp_wu8(colour_get_green(col));
            mp_wu8(colour_get_blue(col));
            mp_wu8(ds_grid_get(g, 9, i) * 255);
        }
        mp_send();
    }
}

// Appended to obj_dialoguer's User Event 0, which has just made its writer.
function mp_mirror_dialoguer_made()
{
    if (!variable_global_exists("mp_inited") || !mp_on() || global.mp_sstate != 1 || mp_player_count() < 2)
        return;
    if (instance_exists(writer))
        mp_mirror_send_dialogue(writer, side);
}

// Sends the text box writer w is showing (from the page it's on) to the followers.
function mp_mirror_send_dialogue(w, sd)
{
    var lines = 0;
    var start = w.msgno;
    for (var i = start; i < 100 && lines < 60; i++)
    {
        var s = w.nstring[i];
        if (!is_string(s))
            break;
        mp_begin(77);
        mp_wu8(lines);
        buffer_write(global.mp_msg, buffer_string, string_copy(s, 1, 1000));
        mp_send();
        lines += 1;
        if (string_length(s) > 0 && string_char_at(s, string_length(s)) == "%")
            break;
    }
    mp_begin(78);
    mp_wu16(global.mp_dlg_n);
    mp_wu8(sd);
    mp_wval(global.fc);
    mp_wval(global.fe);
    mp_wval(global.typer);
    mp_wu8(lines);
    mp_send();
    mp_log("mirror: sent a text box, " + string(lines) + " pages from page " + string(global.mp_dlg_n));
}

// Prepended to snd_play: sounds of my cutscene play for the followers too (not the text box's
// typing, which their own text box makes).
function mp_mirror_snd(snd, vol, pitch)
{
    if (!variable_global_exists("mp_inited") || !mp_on() || global.mp_sstate != 1 || mp_player_count() < 2)
        return;
    // (By name: whichever object plays it, a typing voice is snd_text or snd_txt*.)
    var nm = audio_get_name(snd);
    if (string_pos("snd_tx", nm) == 1 || string_pos("snd_text", nm) == 1)
        return;
    mp_begin(76);
    mp_wu16(snd);
    mp_wu8(clamp(vol, 0, 2.5) * 100);
    mp_wu8(clamp(pitch, 0, 2.5) * 100);
    mp_send();
}

// ---------------------------------------------------------------- follower

// Start mirroring `from`'s cutscene, which began in room rm.
function mp_mirror_start(from, rm)
{
    mp_mirror_reset();
    global.mp_slead = from;
    global.mp_sstate = 5;
    global.mp_idle = 0;
    global.mp_lead_free = 0;
    global.mp_lead_done = 0;
    global.mp_choice_seq = 0;
    global.mp_watch_text = "";
    ds_map_clear(global.mp_choices);
    mp_close_local_dialogue();
    global.interact = 1;
    mp_notify("Watching " + global.mp_pname[from] + "'s cutscene");
    mp_log("mirror: start, leader " + string(from) + ", room " + room_get_name(rm));
    global.mp_warp_mus = from;
    if (room != rm && mp_room_ok(rm))
    {
        // Only the look of the room matters: it's switched off as soon as it starts.
        global.mp_warp_reenter = 0;
        mp_warp(rm, -99999, -99999, 0);
    }
    else
    {
        mp_mirror_freeze();
        mp_music_follow(from);
    }
    // The leader sends the text box that's open, if any.
    mp_begin(79);
    mp_wu8(from);
    mp_send();
}

// Switches off every instance of my room (the room's own objects, my character, the party).
function mp_mirror_freeze()
{
    ds_list_clear(global.mp_mir_list);
    with (all)
    {
        if (!persistent && string_pos("obj_mp_", object_get_name(object_index)) != 1)
            ds_list_add(global.mp_mir_list, id);
    }
    for (var i = 0; i < ds_list_size(global.mp_mir_list); i++)
        instance_deactivate_object(ds_list_find_value(global.mp_mir_list, i));
    global.mp_mir_frozen_room = room;
    mp_log("mirror: room " + room_get_name(room) + " switched off (" + string(ds_list_size(global.mp_mir_list)) + " instances)");
}

// mp_sync_tick, while mirroring.
function mp_mirror_follow_tick()
{
    global.interact = 1;
    var ld = global.mp_slead;
    if (ld < 0 || ld >= 8 || !global.mp_pconn[ld])
    {
        mp_log("mirror: leader gone");
        mp_mirror_end(-1, 0, 0, 0, -1);
        return;
    }
    // The leader's scene is over without our hearing the end (or it only concerned their game).
    if ((global.mp_pstate[ld] & 2) == 0)
        global.mp_lead_free += 1;
    else
        global.mp_lead_free = 0;
    if (global.mp_lead_free > 150)
    {
        mp_log("mirror: leader is no longer in a cutscene");
        mp_mirror_end(-1, 0, 0, 0, -1);
        return;
    }
    if (global.mp_warp_pending)
        return;
    // A room the leader's scene moved to.
    var h = global.mp_mir_hdr;
    if (is_array(h) && h[1] != room && global.mp_warp_delay <= 0 && mp_room_ok(h[1]))
    {
        mp_log("mirror: scene moved to " + room_get_name(h[1]));
        global.mp_warp_reenter = 0;
        mp_warp(h[1], -99999, -99999, 0);
        return;
    }
    // Something of my room still running (it started after the freeze): off with it.
    if (global.mp_mir_frozen_room != room)
        mp_mirror_freeze();
}

// obj_mp_controller Begin Draw time is too late for the view; done in the mirror object's Step.
function mp_mirror_camera()
{
    var h = global.mp_mir_hdr;
    if (global.mp_sstate != 5 || !is_array(h) || h[1] != room)
        return;
    camera_set_view_pos(view_camera[0], h[2], h[3]);
}

function mp_mirror_end(rm, ex, ey, edz, from)
{
    mp_log("mirror: end" + (rm >= 0 ? " in " + room_get_name(rm) : ""));
    with (obj_choicer_neo)
        instance_destroy();
    with (obj_writer)
        instance_destroy();
    with (obj_dialoguer)
        instance_destroy();
    global.interact = 0;
    global.mp_sstate = 0;
    global.mp_slead = -1;
    global.mp_watch_text = "";
    mp_mirror_reset();
    mp_vars_apply_queue();
    // My room was switched off: it's built again (with the story as the scene left it).
    global.mp_warp_reenter = 1;
    if (rm >= 0 && mp_room_ok(rm) && !mp_credits_running())
    {
        if (mp_dz_take(edz))
            global.mp_warp_reenter = 1;
        global.mp_warp_mus = from;
        mp_warp(rm, ex, ey, 0);
    }
    else
    {
        mp_warp(room, -99999, -99999, 0);
    }
}

function mp_mirror_recv(type, from, b)
{
    if (type >= 70 && type <= 75)
    {
        if (global.mp_sstate != 5 || from != global.mp_slead)
            return;
        var seq = buffer_read(b, buffer_u32);
        var rm = buffer_read(b, buffer_u16);
        var cx = buffer_read(b, buffer_s16);
        var cy = buffer_read(b, buffer_s16);
        var c = buffer_read(b, buffer_u8);
        var cnt = buffer_read(b, buffer_u8);
        var m = buffer_read(b, buffer_u8);
        if (c >= 6)
            return;
        var items = array_create(m);
        for (var i = 0; i < m; i++)
        {
            var spr = buffer_read(b, buffer_u16);
            var fr = buffer_read(b, buffer_u8);
            var xx = buffer_read(b, buffer_s16);
            var yy = buffer_read(b, buffer_s16);
            var xs = buffer_read(b, buffer_f32);
            var ys = buffer_read(b, buffer_f32);
            var ang = buffer_read(b, buffer_s16);
            var cr = buffer_read(b, buffer_u8);
            var cg = buffer_read(b, buffer_u8);
            var cb = buffer_read(b, buffer_u8);
            var al = buffer_read(b, buffer_u8);
            items[i] = [spr, fr, xx, yy, xs, ys, ang, make_colour_rgb(cr, cg, cb), al / 255];
        }
        global.mp_mir_chunks[c] = [seq, items];
        var h = global.mp_mir_hdr;
        if (!is_array(h) || seq >= h[0])
            global.mp_mir_hdr = [seq, rm, cx, cy, cnt, current_time];
        return;
    }
    if (type == 76) // a sound of the leader's scene
    {
        var snd = buffer_read(b, buffer_u16);
        var vol = buffer_read(b, buffer_u8) / 100;
        var pitch = buffer_read(b, buffer_u8) / 100;
        if (global.mp_sstate != 5 || from != global.mp_slead || !audio_exists(snd))
            return;
        var s = audio_play_sound(snd, 50, false);
        if (vol != 1)
            audio_sound_gain(s, vol, 0);
        if (pitch != 1)
            audio_sound_pitch(s, pitch);
        return;
    }
    if (type == 77) // a page of the leader's next text box
    {
        var idx = buffer_read(b, buffer_u8);
        var txt = buffer_read(b, buffer_string);
        if (from == global.mp_slead && idx < 64)
            global.mp_mir_lines[idx] = txt;
        return;
    }
    if (type == 78) // ...and the box itself
    {
        var base = buffer_read(b, buffer_u16);
        var sd = buffer_read(b, buffer_u8);
        var fc = mp_rval(b);
        var fe = mp_rval(b);
        var typer = mp_rval(b);
        var nl = buffer_read(b, buffer_u8);
        if (global.mp_sstate == 5 && from == global.mp_slead)
            mp_mirror_show_dialogue(base, sd, fc, fe, typer, nl);
        return;
    }
    if (type == 79) // a follower wants the text box that's open
    {
        var who = buffer_read(b, buffer_u8);
        if (who != global.mp_myid || global.mp_sstate != 1)
            return;
        global.mp_mus_sent = ""; // and my music, again
        var w = -1;
        var sd2 = 1;
        with (obj_dialoguer)
        {
            if (instance_exists(writer))
            {
                w = writer;
                sd2 = side;
            }
        }
        if (w != -1)
            mp_mirror_send_dialogue(w, sd2);
        return;
    }
}

// Opens the leader's text box in my game (the leader turns its pages: mp_dlg_input).
function mp_mirror_show_dialogue(base, sd, fc, fe, typer, nl)
{
    with (obj_choicer_neo)
        instance_destroy();
    with (obj_writer)
        instance_destroy();
    with (obj_dialoguer)
        instance_destroy();
    with (obj_face)
        instance_destroy();
    var sf = asset_get_index("obj_smallface");
    if (sf >= 0)
    {
        with (sf)
            instance_destroy();
    }
    for (var i = 0; i < nl && i < 64; i++)
        global.msg[i] = global.mp_mir_lines[i];
    global.fc = fc;
    global.fe = fe;
    global.typer = typer;
    var d = instance_create(0, 0, obj_dialoguer);
    d.side = sd;
    global.mp_dlg_key = global.mp_slead;
    global.mp_dlg_n = base;
    global.mp_dlg_sent = -1;
    global.mp_dlg_block_since = 0;
    mp_log("mirror: text box, " + string(nl) + " pages from page " + string(base));
}

// obj_choicer_neo's Step while mirroring: show the answer the leader picked.
function mp_mirror_choice_step()
{
    if (!variable_instance_exists(id, "mp_born"))
        mp_born = current_time;
    // (The leader may have picked a moment before my choice box appeared.)
    if (canchoose == 1 && choiced == 0 && global.mp_mir_choice >= 0 && global.mp_mir_choice_t >= (mp_born - 5000))
    {
        mychoice = global.mp_mir_choice;
        global.mp_mir_choice = -1;
        event_user(0);
    }
}

// ---------------------------------------------------------------- obj_mp_mirror

function mp_mirror_obj_step()
{
    mp_mirror_camera();
    // Under the text box (which the game draws at its own depth), over the room.
    var d = -9000;
    with (obj_dialoguer)
        d = max(d, depth + 1);
    with (obj_writer)
        d = max(d, depth + 1);
    with (obj_face)
        d = max(d, depth + 1);
    if (depth != d)
        depth = d;
}

function mp_mirror_draw()
{
    var h = global.mp_mir_hdr;
    if (global.mp_sstate != 5 || !is_array(h) || h[1] != room)
        return;
    var cnt = min(h[4], 6);
    for (var c = 0; c < cnt; c++)
    {
        var ch = global.mp_mir_chunks[c];
        if (!is_array(ch) || (h[0] - ch[0]) > 8)
            continue;
        var items = ch[1];
        var n = array_length(items);
        for (var i = 0; i < n; i++)
        {
            var it = items[i];
            if (sprite_exists(it[0]))
                draw_sprite_ext(it[0], it[1], it[2], it[3], it[4], it[5], it[6], it[7], it[8]);
        }
    }
}
